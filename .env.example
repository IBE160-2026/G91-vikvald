# Settings for Studiekamerat. Copy to .env only if you want to change something;
# the app starts without a .env file and then uses the defaults below.

# Environment. "local" = demo/development mode on your own machine.
APP_ENV=local

# Database connection used by the backend. This default is for development mode
# (backend on your machine, database from `docker compose up db`). Inside Docker
# Compose the backend instead connects to the "db" service.
DATABASE_URL=postgresql+asyncpg://studiekamerat:studiekamerat@localhost:5432/studiekamerat

# Password for the local Postgres container (Docker Compose). Local default only.
# Must match the password in DATABASE_URL. Postgres only sets it the first time the
# database is created: if you change it later, change both values and run
# `docker compose down -v` (this deletes the local database).
POSTGRES_PASSWORD=studiekamerat

# Model provider. "mock" (default) and "mock-invalid" are demo mode: no key needed,
# works offline.
#   mock          makes one flashcard per definition sentence in the notes
#                 («X er …» / «X is …»). The demo content is simple and mechanical:
#                 it shows that the features work, not what a real model can do.
#   mock-invalid  the same cards, but three of every four are broken on purpose.
#                 The broken ones are thrown away and counted on the job
#                 (`discarded`); the message about fewer cards comes in a later story.
#   vertex        Gemini on Google Vertex AI, processed in the EU. Needs a Google
#                 Cloud project, signing in with `gcloud auth application-default
#                 login`, and GOOGLE_CLOUD_PROJECT and VERTEX_MODEL below. README,
#                 «Bruk Gemini (Vertex AI)», shows every step.
# Any other value stops the backend at startup, with a log line naming LLM_PROVIDER.
LLM_PROVIDER=mock

# Only used with LLM_PROVIDER=vertex. If GOOGLE_CLOUD_PROJECT or VERTEX_MODEL is
# missing then, the backend refuses to start with a log line naming the setting.
# The backend signs in with Application Default Credentials (no key file), and
# always uses the EU endpoint (aiplatform.eu.rep.googleapis.com); the location
# cannot be changed. These values stay on the server and never reach the browser.
# Your Google Cloud project ID, e.g. my-project-123. Never commit the real value.
GOOGLE_CLOUD_PROJECT=
# The Gemini model. A placeholder until the quality test settles the choice.
VERTEX_MODEL=gemini-3.5-flash
# How much the model thinks before it answers: minimal, low (default), medium or high.
# More thinking is slower and costs more.
VERTEX_THINKING=low

# Switches for the extra features: memory aids, free-text questions and summary.
# true (default) = on. false = off; their API routes then answer 404 FEATURE_DISABLED.
FEATURE_MNEMONICS=true
FEATURE_FREETEXT=true
FEATURE_SUMMARY=true

# Secret key that signs the login cookie (sk_session). Leave it empty locally: with
# APP_ENV=local the backend uses a built-in local key. In any other environment it
# must be set to a long random value (for example `openssl rand -hex 32`), or the
# backend refuses to start with a log line naming JWT_SECRET. Never commit the real key.
JWT_SECRET=

# Folder where the backend stores uploaded PDFs (as <user_id>/<file_id>.pdf).
# A relative path is relative to the folder the backend starts in. In Docker
# Compose this is /app/data/uploads, where the "uploads" volume is mounted, so the
# files survive a restart of the backend. Docker Compose does not pass UPLOAD_DIR
# on, so this setting only applies when the backend runs outside Docker.
UPLOAD_DIR=data/uploads

# Largest PDF that can be uploaded, in MB (1 MB = 1024 x 1024 bytes). Positive whole number.
MAX_UPLOAD_MB=20

# Where the frontend forwards /api/* (read when the frontend is built or `npm run dev` starts).
# Docker Compose uses http://backend:8000. In development mode, set it on the command
# line as README shows (API_INTERNAL_URL=http://localhost:8000 npm run dev), not here.
API_INTERNAL_URL=http://backend:8000
